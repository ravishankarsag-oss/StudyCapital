# StudyCapital .htaccess — SEO + Security + Performance

# ── Enable Rewrite Engine ────────────────────────────────────────────────────
Options -Indexes
RewriteEngine On

# ── Force HTTPS + www in ONE hop (fixes redirect chain) ──────────────────────
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.studycapital.in/$1 [L,R=301,NE]

# ── Add trailing slash to directory URLs (matches sitemap + folder structure) ─
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ https://www.studycapital.in/$1/ [L,R=301]

# ── Serve index.html from clean folder URLs ──────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)/$ /$1/index.html [L]

# ── Security Headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.clarity.ms https://scripts.clarity.ms https://www.googletagmanager.com https://maps.googleapis.com https://api.emailjs.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://challenges.cloudflare.com; font-src https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://studycapital-form-handler.studycapital2026.workers.dev https://api.telegram.org https://api.emailjs.com https://challenges.cloudflare.com https://maps.googleapis.com https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://region1.google-analytics.com https://region1.analytics.google.com; frame-src https://maps.google.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self';"
</IfModule>

# ── Cache static assets ──────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType image/x-icon      "access plus 1 year"
  ExpiresByType text/css          "access plus 6 months"
  ExpiresByType application/javascript "access plus 6 months"
  ExpiresByType application/json  "access plus 1 week"
  ExpiresByType text/html         "access plus 1 hour"
  ExpiresByType font/woff2        "access plus 1 year"
  ExpiresByType font/woff         "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ── Explicit Cache-Control headers (GTmetrix / Lighthouse requirement) ────────
<IfModule mod_headers.c>
  # Long-lived static assets (immutable)
  <FilesMatch "\.(ico|jpg|jpeg|png|webp|gif|svg|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # CSS and JS (6 months, versioned via query string in HTML)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
  # HTML (short cache, must-revalidate)
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # manifest.json
  <FilesMatch "manifest\.json$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ── ETags ───────────────────────────────────────────────────────────────────
FileETag MTime Size

# ── Brotli Compression (preferred, smaller than gzip) ─────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json text/xml font/woff2
</IfModule>

# ── GZIP Compression (fallback) ───────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml font/woff font/woff2
</IfModule>

# ── Block bad bots ───────────────────────────────────────────────────────────
RewriteCond %{HTTP_USER_AGENT} (nikto|sqlmap|masscan|zgrab|nmap|acunetix|burpsuite|nessus|openvas) [NC]
RewriteRule .* - [F,L]

# ── Block direct access to sensitive files ────────────────────────────────────
<FilesMatch "\.(htaccess|htpasswd|env|git|sh|sql|bak|log)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ── Custom error pages ───────────────────────────────────────────────────────
ErrorDocument 404 /404.html
